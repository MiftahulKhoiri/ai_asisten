[Unit]
Description=AI Asisten (tampilan web)
After=llama-server.service
Wants=llama-server.service

[Service]
Type=simple
WorkingDirectory=@DIR@
Environment=LLAMA_BASE_URL=http://127.0.0.1:@PORT@
Environment=ASISTEN_MODELS_DIR=@MODELS_DIR@
Environment=ASISTEN_CTX=@CTX@
# Pengaturan tambahan (opsional), satu baris NAMA=nilai, mis. ASISTEN_LOG_MAKS_KB=2048
EnvironmentFile=-%h/.config/ai_asisten.env
ExecStart=@PYTHON@ @DIR@/asisten.py --tanpa-warna
Restart=on-failure
RestartSec=5
TimeoutStopSec=30

[Install]
WantedBy=default.target
